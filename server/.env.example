# Healix Clinic - Email & SMTP Configuration for Admin OTP
# Option 1: Gmail App Password (Recommended for testing with personal email)
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Go to Google Account -> Security -> 2-Step Verification -> App Passwords
# 3. Create an App Password for 'Healix Clinic'
GMAIL_USER=calvinjoelc@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password

# Option 2: Custom SMTP Server
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@yourdomain.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=security@healixphysio.com

# Note: If no SMTP credentials are provided, the system will automatically log the OTP
# to the server console and provide a development preview banner for seamless testing.
